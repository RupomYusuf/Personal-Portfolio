---
import { Image } from 'astro:assets';
import '@fontsource/anton';
import portraitHero from '../assets/portrait-hero.png';
import imgRose from '../assets/projects/rose-lady/cover.jpg';
import imgLeaf from '../assets/projects/leafiesta-logo/cover.jpg';
import imgPizza from '../assets/projects/pizza-flyer/cover.jpg';
import imgCity from '../assets/projects/this-city-is-ours/cover.jpg';

const work = [
  { title: 'ROSE LADY', meta: 'ILLUSTRATION', img: imgRose },
  { title: 'LEAFIESTA', meta: 'BRANDING', img: imgLeaf },
  { title: 'PIZZA FRIDAY', meta: 'PRINT', img: imgPizza },
  { title: 'THIS CITY IS OURS', meta: 'ILLUSTRATION', img: imgCity },
];

const words = ['LOGO DESIGN', 'BRAND IDENTITY', 'ILLUSTRATION', 'PRINT & FLYERS', 'POSTERS', 'SOCIAL GRAPHICS'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Variant C — Bold Poster | Rupom Morol</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #ffd42a;
        color: #101014;
        font-family: 'Anton', system-ui, sans-serif;
        line-height: 1.4;
        overflow-x: clip;
      }
      a { color: inherit; }
      .wrap { max-width: 78rem; margin-inline: auto; padding-inline: 1.5rem; }

      header { border-bottom: 4px solid #101014; background: #ffd42a; }
      .bar { display: flex; justify-content: space-between; align-items: center; padding-block: 0.9rem; }
      .brand { font-size: 1.5rem; letter-spacing: 0.02em; text-decoration: none; text-transform: uppercase; }
      nav { display: flex; gap: 0.3rem; font-family: system-ui, sans-serif; font-weight: 700; }
      nav a {
        text-decoration: none; text-transform: uppercase; font-size: 0.85rem;
        padding: 0.5rem 0.8rem; border: 3px solid #101014; background: #ffd42a; transition: all 0.1s;
      }
      nav a:hover { background: #101014; color: #ffd42a; }

      .hero {
        display: grid; grid-template-columns: 1.3fr 0.7fr;
        border-bottom: 4px solid #101014;
      }
      .hero__left { padding: 3.5rem 0 3rem; }
      .hero__name {
        font-size: clamp(4rem, 13vw, 12rem); line-height: 0.88; text-transform: uppercase;
        margin: 0 0 1.5rem; letter-spacing: 0.01em;
      }
      .hero__name span { display: block; }
      .hero__name span:last-child {
        -webkit-text-stroke: 3px #101014; color: transparent;
      }
      .tag { font-family: system-ui, sans-serif; font-weight: 700; font-size: 1.05rem; max-width: 26rem; margin: 0 0 1.8rem; }
      .cta {
        display: inline-block; background: #101014; color: #ffd42a; text-decoration: none;
        text-transform: uppercase; padding: 0.9rem 2rem; font-size: 1.1rem; letter-spacing: 0.05em;
        border: 3px solid #101014; box-shadow: 6px 6px 0 #101014; transition: all 0.12s;
      }
      .cta:hover { transform: translate(3px, 3px); box-shadow: 3px 3px 0 #101014; }
      .hero__right { position: relative; display: flex; align-items: end; justify-content: center; }
      .hero__right img { width: 100%; max-width: 26rem; display: block; margin-bottom: -4px; }
      .avail {
        position: absolute; top: 1.2rem; right: 0; background: #101014; color: #ffd42a;
        padding: 0.4rem 1rem; font-family: system-ui, sans-serif; font-weight: 700;
        font-size: 0.85rem; text-transform: uppercase; transform: rotate(3deg);
      }

      .marquee {
        background: #101014; color: #ffd42a; overflow: clip; padding-block: 0.8rem;
        border-bottom: 4px solid #101014;
      }
      .marquee__track { display: flex; gap: 3rem; white-space: nowrap; animation: slide 22s linear infinite; width: max-content; }
      .marquee span { font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.06em; }
      @keyframes slide { to { transform: translateX(-50%); } }

      .work { padding-block: 3.5rem; border-bottom: 4px solid #101014; }
      .work h2 { font-size: clamp(2.4rem, 6vw, 4.5rem); text-transform: uppercase; margin: 0 0 2rem; }
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 2rem 1.5rem; }
      .card { text-decoration: none; display: block; }
      .card__frame {
        border: 4px solid #101014; background: #fff; box-shadow: 8px 8px 0 #101014;
        transition: all 0.12s; overflow: hidden;
      }
      .card:hover .card__frame { transform: translate(4px, 4px); box-shadow: 4px 4px 0 #101014; }
      .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
      .card__bar { display: flex; justify-content: space-between; align-items: center; padding: 0.8rem 1rem; font-size: 1.2rem; text-transform: uppercase; }
      .card__meta { font-family: system-ui, sans-serif; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.08em; }

      .cta { background: #101014; color: #ffd42a; }
      .cta__in { padding-block: 4rem; text-align: center; }
      .cta h2 { font-size: clamp(2.6rem, 8vw, 6.5rem); text-transform: uppercase; margin: 0 0 1.5rem; line-height: 0.95; }
      .cta a {
        display: inline-block; background: #ffd42a; color: #101014; text-decoration: none;
        text-transform: uppercase; padding: 1rem 2.4rem; font-size: 1.2rem;
        border: 3px solid #ffd42a; box-shadow: 6px 6px 0 #ffd42a; transition: all 0.12s;
      }
      .cta a:hover { transform: translate(3px, 3px); box-shadow: 3px 3px 0 #ffd42a; }
      .footer { padding-block: 1.2rem; background: #101014; color: #ffd42a; font-family: system-ui, sans-serif; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; }
      @media (max-width: 56rem) {
        .hero { grid-template-columns: 1fr; }
        .hero__right { order: -1; }
      }
    </style>
  </head>
  <body>
    <header><div class="wrap bar">
      <a class="brand" href="#">Rupom Morol</a>
      <nav><a href="#">Work</a><a href="#">About</a><a href="#">Contact</a></nav>
    </div></header>

    <section class="hero">
      <div class="wrap hero__left">
        <h1 class="hero__name"><span>Rupom</span><span>Morol</span></h1>
        <p class="tag">Graphic designer. 8 years of logo, brand and print work. Fiverr Level 2 Seller. Currently booking.</p>
        <a class="cta" href="#contact">Get in touch</a>
      </div>
      <div class="hero__right">
        <span class="avail">Available for work</span>
        <img src={portraitHero.src} alt="Portrait of Rupom Morol" />
      </div>
    </section>

    <div class="marquee">
      <div class="marquee__track">
        {words.concat(words).map((w) => <span>{w}</span>)}
      </div>
    </div>

    <section class="work">
      <div class="wrap">
        <h2>Selected work</h2>
        <div class="cards">
          {
            work.map((w) => (
              <a class="card" href="#contact">
                <div class="card__frame">
                  <img src={w.img.src} alt={w.title} loading="lazy" />
                  <div class="card__bar">
                    <span>{w.title}</span>
                    <span class="card__meta">{w.meta}</span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap cta__in">
        <h2>Have work that needs a designer?</h2>
        <a href="mailto:abdullahyusufrupom@gmail.com">Get in touch</a>
      </div>
    </section>
    <div class="wrap"><p class="footer">© 2026 Rupom Morol, Graphic Designer</p></div>
  </body>
</html>
