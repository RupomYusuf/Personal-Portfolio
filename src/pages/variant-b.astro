---
import { Image } from 'astro:assets';
import '@fontsource-variable/outfit';
import portraitHero from '../assets/portrait-hero.png';
import imgRose from '../assets/projects/rose-lady/cover.jpg';
import imgLeaf from '../assets/projects/leafiesta-logo/cover.jpg';
import imgPizza from '../assets/projects/pizza-flyer/cover.jpg';
import imgCity from '../assets/projects/this-city-is-ours/cover.jpg';

const work = [
  { title: 'Rose Lady', meta: 'Illustration', img: imgRose },
  { title: 'Leafiesta Logo', meta: 'Branding', img: imgLeaf },
  { title: 'Pizza Friday Flyer', meta: 'Print', img: imgPizza },
  { title: 'This City Is Ours', meta: 'Illustration', img: imgCity },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Variant B — Soft Dark Premium | Rupom Morol</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #0e1020;
        color: #eceafd;
        font-family: 'Outfit Variable', system-ui, sans-serif;
        line-height: 1.5;
        overflow-x: clip;
      }
      a { color: inherit; }
      .wrap { max-width: 74rem; margin-inline: auto; padding-inline: 1.5rem; }

      header {
        position: sticky; top: 0; z-index: 50;
        backdrop-filter: blur(14px);
        background: rgb(14 16 32 / 0.7);
      }
      .bar { display: flex; justify-content: space-between; align-items: center; padding-block: 0.9rem; }
      .brand { font-weight: 600; font-size: 1.15rem; text-decoration: none; }
      nav { display: flex; gap: 0.4rem; }
      nav a {
        text-decoration: none; color: #b9b6e8; font-size: 0.95rem;
        padding: 0.5rem 0.9rem; border-radius: 999px; transition: all 0.2s ease;
      }
      nav a:hover { color: #fff; background: rgb(255 255 255 / 0.08); }
      nav a.on { background: #7c6bff; color: #0e1020; font-weight: 600; }

      .glow {
        position: relative;
        padding-block: 4.5rem 3.5rem;
      }
      .glow::before {
        content: '';
        position: absolute; inset: -20% 30% auto auto; width: 34rem; height: 30rem;
        background:
          radial-gradient(circle at 30% 40%, rgb(124 107 255 / 0.5), transparent 60%),
          radial-gradient(circle at 70% 60%, rgb(255 122 216 / 0.3), transparent 55%);
        filter: blur(30px);
        pointer-events: none;
      }
      .hero { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3rem; align-items: center; }
      .eyebrow {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: rgb(124 107 255 / 0.16); border: 1px solid rgb(124 107 255 / 0.4);
        color: #cfc9ff; border-radius: 999px; padding: 0.35rem 1rem; font-size: 0.9rem; margin: 0 0 1.4rem;
      }
      .eyebrow::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #7c6bff; }
      h1 { font-size: clamp(2.8rem, 6.5vw, 5.2rem); line-height: 1.04; margin: 0 0 1.2rem; font-weight: 600; letter-spacing: -0.02em; }
      h1 span { color: #8f7dff; }
      .lead { color: #b9b6e8; font-size: 1.15rem; max-width: 30rem; margin: 0 0 1.8rem; }
      .hero__cta {
        display: inline-block; background: #7c6bff; color: #0e1020; font-weight: 600;
        padding: 0.85rem 1.8rem; border-radius: 999px; text-decoration: none; transition: transform 0.2s ease;
      }
      .hero__cta:hover { transform: translateY(-2px); }
      .hero__portrait { position: relative; z-index: 1; }
      .hero__portrait img {
        width: 100%; border-radius: 24px; display: block;
        filter: saturate(0.9);
      }

      .stats {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-block: 3rem 4rem;
      }
      .stat {
        background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.09);
        border-radius: 20px; padding: 1.4rem 1.6rem;
      }
      .stat strong { font-size: 2.2rem; font-weight: 600; display: block; }
      .stat span { color: #b9b6e8; }

      .work__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem; }
      .work__head h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); margin: 0; font-weight: 600; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1.2rem; padding-bottom: 4rem; }
      .card {
        background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.09);
        border-radius: 20px; overflow: hidden; text-decoration: none; display: block;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }
      .card:hover { transform: translateY(-4px); border-color: rgb(124 107 255 / 0.6); }
      .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
      .card__meta { padding: 1rem 1.2rem 1.2rem; }
      .card__title { margin: 0; font-size: 1.15rem; font-weight: 600; }
      .card__cat { margin: 0.2rem 0 0; color: #b9b6e8; font-size: 0.9rem; }

      .cta {
        background: linear-gradient(135deg, #7c6bff, #b96bff 55%, #ff7ad8);
        color: #0e1020; border-radius: 28px; margin-bottom: 3rem;
      }
      .cta__in { padding: 3.5rem; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; align-items: center; }
      .cta h2 { font-size: clamp(1.8rem, 4.5vw, 3.2rem); margin: 0; font-weight: 600; }
      .cta a { font-weight: 600; color: #0e1020; font-size: 1.1rem; }
      .footer { padding-block: 1.2rem 2rem; color: #8f8cba; font-size: 0.9rem; }
      @media (max-width: 56rem) {
        .hero { grid-template-columns: 1fr; }
        .stats { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header><div class="wrap bar">
      <a class="brand" href="#">Rupom Morol</a>
      <nav><a class="on" href="#">Home</a><a href="#">Work</a><a href="#">About</a><a href="#">Contact</a></nav>
    </div></header>

    <div class="wrap glow">
      <section class="hero">
        <div>
          <p class="eyebrow">Currently booking new projects</p>
          <h1>Design with personality, <span>precision</span> and 8 years of practice.</h1>
          <p class="lead">Brand identity, illustration and print by Rupom Morol, Fiverr Level 2 Seller.</p>
          <a class="hero__cta" href="#contact">Get in touch</a>
        </div>
        <div class="hero__portrait">
          <img src={portraitHero.src} alt="Portrait of Rupom Morol" />
        </div>
      </section>

      <section class="stats">
        <div class="stat"><strong>8+</strong><span>Years of experience</span></div>
        <div class="stat"><strong>23</strong><span>Projects in this portfolio</span></div>
        <div class="stat"><strong>L2</strong><span>Fiverr Level 2 Seller</span></div>
      </section>

      <section>
        <div class="work__head"><h2>Selected work</h2></div>
        <div class="grid">
          {
            work.map((w) => (
              <a class="card" href="#contact">
                <img src={w.img.src} alt={w.title} loading="lazy" />
                <div class="card__meta">
                  <h3 class="card__title">{w.title}</h3>
                  <p class="card__cat">{w.meta}</p>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <section class="cta">
        <div class="cta__in">
          <h2>Have work that needs a designer?</h2>
          <a href="mailto:abdullahyusufrupom@gmail.com">abdullahyusufrupom@gmail.com</a>
        </div>
      </section>
      <p class="footer">© 2026 Rupom Morol, Graphic Designer</p>
    </div>
  </body>
</html>
