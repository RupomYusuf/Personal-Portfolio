---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectsSorted } from '../lib/projects';

const projects = await getProjectsSorted();
const categories = [...new Set(projects.map((p) => p.data.category))];
const tabs = ['All', ...categories];
---

<BaseLayout
  title="Work"
  description="Branding, illustration, and print projects by Rupom Morol."
>
  <section class="container" style="position: relative;">
    <div class="glow" aria-hidden="true" style="inset: -10% 55% 40% auto; width: 30rem; height: 26rem;"></div>
    <h1>Selected work</h1>
    <div class="filters" role="group" aria-label="Filter projects by category">
      {
        tabs.map((tab, i) => (
          <button type="button" data-filter={tab} aria-pressed={i === 0}>
            {tab}
          </button>
        ))
      }
    </div>
    <div class="grid" data-reveal>
      {projects.map((p, i) => <ProjectCard project={p} wide={i === 0} />)}
    </div>
  </section>
</BaseLayout>

<script>
  import { initFilter } from '../scripts/filter';
  initFilter();
</script>

<style>
  h1 {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin: var(--space-3) 0 var(--space-3);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-3);
  }

  .filters button {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .filters button:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.08);
  }

  .filters button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-2);
    padding-bottom: var(--space-5);
  }

  .grid :global(.card--wide) {
    grid-column: span 2;
  }

  @media (max-width: 48rem) {
    .grid :global(.card--wide) {
      grid-column: auto;
    }
  }
</style>
