---
import { Image } from 'astro:assets';
import '@fontsource-variable/archivo';
import portraitHero from '../assets/portrait-hero.png';
import imgRose from '../assets/projects/rose-lady/cover.jpg';
import imgLeaf from '../assets/projects/leafiesta-logo/cover.jpg';
import imgPizza from '../assets/projects/pizza-flyer/cover.jpg';
import imgCity from '../assets/projects/this-city-is-ours/cover.jpg';

const work = [
  { title: 'Rose Lady', meta: 'Illustration · 2020', img: imgRose },
  { title: 'Leafiesta Logo', meta: 'Branding · 2020', img: imgLeaf },
  { title: 'Pizza Friday Flyer', meta: 'Print · 2021', img: imgPizza },
  { title: 'This City Is Ours', meta: 'Illustration · 2020', img: imgCity },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Variant A — Editorial Light | Rupom Morol</title>
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: #f7f6f2;
        color: #101012;
        font-family: 'Archivo Variable', system-ui, sans-serif;
        line-height: 1.5;
      }
      a { color: inherit; }
      .wrap { max-width: 76rem; margin-inline: auto; padding-inline: 1.5rem; }

      .masthead {
        display: flex; justify-content: space-between; align-items: baseline;
        padding-block: 1.2rem; border-bottom: 1px solid #101012;
      }
      .brand { font-weight: 700; font-size: 1.1rem; letter-spacing: 0.02em; }
      nav { display: flex; gap: 1.5rem; }
      nav a { text-decoration: none; font-size: 0.95rem; }

      .hero { padding-block: 4.5rem 3.5rem; display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 3rem; align-items: end; }
      .kicker { font-size: 0.95rem; color: #4b4b50; margin: 0 0 1rem; }
      h1 { font-size: clamp(3rem, 8.5vw, 7rem); line-height: 0.95; letter-spacing: -0.03em; margin: 0; font-weight: 600; }
      h1 em { font-style: normal; color: #2743d0; }
      .hero__portrait { position: relative; }
      .hero__portrait img { width: 100%; display: block; filter: saturate(0.92); }
      .hero__caption { font-size: 0.85rem; color: #4b4b50; margin-top: 0.6rem; }
      .hero__under { display: flex; flex-wrap: wrap; gap: 1rem 2.5rem; align-items: baseline; padding-block: 1.6rem; border-top: 1px solid #101012; }
      .hero__under p { margin: 0; }
      .hero__cta a {
        display: inline-block; background: #101012; color: #f7f6f2;
        padding: 0.75rem 1.6rem; text-decoration: none; font-weight: 600;
      }
      .stats { display: flex; gap: 3rem; color: #4b4b50; font-size: 0.95rem; }

      .work { padding-block: 3rem 4rem; }
      .work__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem; }
      .work__head h2 { font-size: 1rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; margin: 0; }
      .row {
        display: grid; grid-template-columns: auto 1fr auto; gap: 2rem; align-items: center;
        padding-block: 1.6rem; border-top: 1px solid rgb(16 16 18 / 0.25); text-decoration: none;
        transition: background 0.2s ease;
      }
      .row:hover { background: #ffffff; }
      .row__num { font-size: 0.9rem; color: #4b4b50; width: 2rem; }
      .row__title { font-size: clamp(1.8rem, 4.5vw, 3.4rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; line-height: 1; }
      .row__meta { color: #4b4b50; font-size: 0.9rem; margin: 0.3rem 0 0; }
      .row img { width: 9.5rem; height: auto; display: block; }
      .work__all { display: block; margin-top: 1.5rem; font-weight: 600; }

      .cta { background: #101012; color: #f7f6f2; padding-block: 5rem; }
      .cta h2 { font-size: clamp(2.2rem, 6vw, 4.5rem); margin: 0 0 1rem; font-weight: 600; letter-spacing: -0.02em; }
      .cta a { color: #f7f6f2; font-size: 1.2rem; }
      .footer { padding-block: 1.2rem; border-top: 1px solid rgb(16 16 18 / 0.25); color: #4b4b50; font-size: 0.9rem; }
      @media (max-width: 56rem) {
        .hero { grid-template-columns: 1fr; }
        .row { grid-template-columns: auto 1fr; }
        .row img { display: none; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <div class="masthead">
        <span class="brand">Rupom Morol</span>
        <nav><a>Work</a><a>About</a><a>Contact</a></nav>
      </div>

      <section class="hero">
        <div>
          <p class="kicker">Graphic designer, 8 years in. Fiverr Level 2 Seller. Currently booking.</p>
          <h1>I make brands<br />and images <em>speak.</em></h1>
        </div>
        <div class="hero__portrait">
          <img src={portraitHero.src} alt="Portrait of Rupom Morol" />
          <p class="hero__caption">Rupom Morol, designer</p>
        </div>
      </section>
      <div class="hero__under">
        <p class="stats"><span>8+ years</span></p>
        <p class="stats"><span>23 projects</span></p>
        <p class="hero__cta"><a href="#contact">Get in touch</a></p>
      </div>

      <section class="work">
        <div class="work__head"><h2>Selected work</h2><span>2020 – 2021</span></div>
        {
          work.map((w, i) => (
            <a class="row" href="#contact">
              <span class="row__num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="row__title">{w.title}</h3>
                <p class="row__meta">{w.meta}</p>
              </div>
              <img src={w.img.src} alt={w.title} loading="lazy" />
            </a>
          ))
        }
        <a class="work__all" href="#contact">All 23 projects →</a>
      </section>
    </div>

    <section class="cta">
      <div class="wrap">
        <h2>Have work that needs a designer?</h2>
        <a href="mailto:abdullahyusufrupom@gmail.com">abdullahyusufrupom@gmail.com</a>
      </div>
    </section>
    <div class="wrap"><p class="footer">© 2026 Rupom Morol, Graphic Designer</p></div>
  </body>
</html>
