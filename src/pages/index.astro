---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectsSorted, getFeatured } from '../lib/projects';
import { site } from '../config';
import portraitHero from '../assets/portrait-hero.png';
import imgLeaf from '../assets/projects/leafiesta-logo/cover.jpg';
import imgRose from '../assets/projects/rose-lady/cover.jpg';
import imgPizza from '../assets/projects/pizza-flyer/cover.jpg';
import imgCity from '../assets/projects/this-city-is-ours/cover.jpg';

const featured = await getFeatured(site.featuredCount);
const projectCount = (await getProjectsSorted()).length;

const roles = [
  'Brand Identity Designer',
  'Illustration & Character Artist',
  'Print & Flyer Designer',
];
---

<BaseLayout title={site.name} description={site.intro} ogImage={imgRose.src}>
  <section class="hero">
    <div class="glow hero__glow" aria-hidden="true"></div>
    <div class="container hero__stage">
      <p class="hero__eyebrow">{site.availability}</p>

      <div class="hero__stage-inner">
        <p class="hero__name" aria-label={site.name}>
          <span aria-hidden="true">Rupom</span>
          <span class="hero__name-second" aria-hidden="true">Morol</span>
        </p>
        <div class="hero__portrait">
          <Image
            src={portraitHero}
            alt={`Portrait of ${site.name}, graphic designer`}
            width={900}
            priority
          />
        </div>
        <div class="hero__aside">
          <p class="hero__iam">I am {site.name}!</p>
          <p class="hero__blurb">{site.intro}</p>
          <p class="hero__arrow" aria-hidden="true">↘</p>
        </div>
      </div>

      <ul class="hero__roles">
        {
          roles.map((r, i) => (
            <li>
              <span class="hero__role-num">({String(i + 1).padStart(2, '0')})</span>
              <span class="hero__role-name">{r}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container statement" data-reveal>
    <p class="pill">About me</p>
    <h2 class="statement__text">
      As a graphic designer, I've spent {site.yearsExperience} years helping
      brands <span>find their visual voice</span>, from logos to full print
      systems, and I'd love to do the same for yours.
    </h2>
    <div class="stats">
      <div class="stats__item"><strong>{site.yearsExperience}+</strong><span>Years of experience</span></div>
      <div class="stats__item"><strong>{projectCount}</strong><span>Projects in this portfolio</span></div>
      <div class="stats__item"><strong>L2</strong><span>Fiverr Level 2 Seller</span></div>
      <div class="stats__item"><strong>100%</strong><span>Original, hand-crafted work</span></div>
    </div>
  </section>

  <section class="container services" data-reveal>
    <div class="work__head">
      <h2 class="section-title">What I do</h2>
      <a class="work__all" href="/work/">See all work →</a>
    </div>
    <div class="services__grid">
      {
        [
          { name: 'Logo & Brand Identity', img: imgLeaf, alt: 'Leafiesta logo design' },
          { name: 'Character & Illustration', img: imgRose, alt: 'Rose Lady illustration' },
          { name: 'Print & Flyer Design', img: imgPizza, alt: 'Pizza Friday flyer' },
          { name: 'Poster & Social Graphics', img: imgCity, alt: 'This City Is Ours poster art' },
        ].map((s) => (
          <div class="services__card">
            <img src={s.img.src} alt={s.alt} loading="lazy" width="400" height="300" />
            <h3>{s.name}</h3>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container" data-reveal>
    <div class="work__head">
      <h2 class="section-title">Selected work</h2>
      <a class="work__all" href="/work/">See all work →</a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="container" data-reveal>
    <div class="cta">
      <div class="cta__inner">
        <h2>Have work that needs a designer?</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
  }

  .hero__glow {
    inset: -30% 20% auto auto;
    width: 44rem;
    height: 38rem;
  }

  .hero__stage {
    position: relative;
    padding-block: var(--space-2) var(--space-3);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgb(124 107 255 / 0.16);
    border: 1px solid rgb(124 107 255 / 0.4);
    color: #cfc9ff;
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-size: 0.9rem;
    margin: 0 0 var(--space-2);
  }

  .hero__eyebrow::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* portrait centre-stage, pixel name glowing behind */
  .hero__stage-inner {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__name {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(4rem, 16vw, 13rem);
    line-height: 0.82;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    filter: blur(1.5px);
    pointer-events: none;
  }

  .hero__name span {
    background: linear-gradient(180deg, #b9a8ff 8%, var(--accent) 55%, rgb(255 122 216 / 0.1) 96%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__name-second {
    margin-top: -0.12em;
  }

  .hero__portrait {
    position: relative;
    z-index: 1;
    width: clamp(16rem, 36vw, 28rem);
    filter: drop-shadow(0 2.2rem 3.5rem rgb(6 7 18 / 0.65));
  }

  .hero__aside {
    position: absolute;
    right: 0;
    top: 12%;
    width: 14rem;
    text-align: right;
  }

  .hero__iam {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    font-weight: 500;
    margin: 0 0 0.6rem;
    color: var(--ink);
  }

  .hero__blurb {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1.2rem;
  }

  .hero__arrow {
    font-size: 2rem;
    color: var(--accent);
    margin: 0;
    animation: nudge 2.4s ease-in-out infinite;
  }

  @keyframes nudge {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(0.4rem, 0.4rem); }
  }

  .hero__roles {
    position: relative;
    z-index: 2;
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: max-content;
  }

  .hero__roles li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .hero__role-num {
    font-family: system-ui, sans-serif;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .hero__role-name {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    color: var(--ink);
  }

  @media (max-width: 56rem) {
    .hero__name {
      width: 130%;
      filter: blur(1px);
    }

    .hero__portrait {
      width: min(72vw, 20rem);
    }

    .hero__aside {
      position: static;
      width: auto;
      text-align: left;
      margin-top: 1.4rem;
    }

    .hero__arrow {
      display: none;
    }
  }

  .statement {
    padding-block: var(--space-3);
  }

  .pill {
    display: inline-block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 1rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0 0 var(--space-2);
  }

  .statement__text {
    font-size: clamp(1.5rem, 3.6vw, 2.6rem);
    font-weight: 600;
    max-width: 58rem;
    margin: 0 0 var(--space-3);
  }

  .statement__text span {
    color: #8f7dff;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-2);
  }

  .stats__item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
  }

  .stats__item strong {
    font-size: 1.9rem;
    font-weight: 600;
    display: block;
    color: #8f7dff;
  }

  .stats__item span {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 48rem) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .section-title {
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    margin: 0 0 var(--space-3);
  }

  .services {
    padding-block: var(--space-2) var(--space-4);
  }

  .work__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .work__all {
    color: var(--muted);
    font-weight: 600;
  }

  .work__all:hover {
    color: var(--ink);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-2);
  }

  .services__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .services__card:hover {
    transform: translateY(-4px);
    border-color: rgb(124 107 255 / 0.6);
  }

  .services__card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .services__card h3 {
    font-size: 1.05rem;
    margin: 0;
    padding: 1rem 1.2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .cta {
    background: linear-gradient(135deg, #7c6bff, #b96bff 55%, #ff7ad8);
    color: var(--accent-ink);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .cta__inner {
    padding: var(--space-4) var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    align-items: center;
  }

  .cta h2 {
    font-size: clamp(1.8rem, 4.5vw, 3.2rem);
    margin: 0;
    color: var(--accent-ink);
  }

  .cta a {
    font-weight: 600;
    color: var(--accent-ink);
    font-size: 1.1rem;
  }
</style>
