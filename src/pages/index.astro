---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeatured } from '../lib/projects';
import { site } from '../config';
import portraitHero from '../assets/portrait-hero.jpg';

const featured = await getFeatured(site.featuredCount);
---

<BaseLayout title={site.name} description={site.intro} ogImage={portraitHero.src}>
  <section class="container hero">
    <div class="hero__text">
      <p class="hero__availability">{site.availability}</p>
      <h1 class="hero__title">{site.name}</h1>
      <p class="hero__role">{site.role} — {site.intro}</p>
      <p class="hero__trust">
        {site.yearsExperience} years of experience · {site.fiverr.level}
      </p>
      <p class="hero__cta"><a href="/contact/">Get in touch</a></p>
    </div>
    <div class="hero__photo">
      <Image
        src={portraitHero}
        alt={`Portrait of ${site.name}, graphic designer`}
        width={1000}
        priority
      />
    </div>
  </section>

  <section class="container" data-reveal>
    <h2>Selected work</h2>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
    <p><a href="/work/">See all work →</a></p>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: end;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-4);
    overflow-x: clip;
  }

  .hero__availability {
    color: var(--accent);
    font-weight: 600;
    margin: 0;
  }

  .hero__title {
    font-size: clamp(3.5rem, 12vw, 9rem);
    margin: 0 0 var(--space-2);
    position: relative;
    z-index: 2;
    /* type breaks the grid and runs over the portrait edge */
    width: 175%;
    max-width: none;
    text-transform: uppercase;
  }

  .hero__role {
    font-size: 1.3rem;
    max-width: 40rem;
    color: var(--ink);
  }

  .hero__trust {
    color: var(--muted);
  }

  .hero__cta a {
    display: inline-block;
    font-weight: 600;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.7rem 1.6rem;
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .hero__cta a:hover {
    transform: translateY(-1px);
  }

  .hero__cta a:active {
    transform: scale(0.98);
  }

  .hero__photo {
    position: relative;
  }

  .hero__photo::before {
    content: '';
    position: absolute;
    left: 45%;
    right: -6%;
    bottom: -5%;
    height: 42%;
    background: var(--accent);
  }

  .hero__photo :global(img) {
    position: relative;
    z-index: 1;
    display: block;
  }

  @media (max-width: 56rem) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: var(--space-3) var(--space-4);
    }

    .hero__title {
      width: 100%;
    }

    .hero__photo {
      max-width: 24rem;
    }
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
</style>
