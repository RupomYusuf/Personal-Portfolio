---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjectsSorted, getFeatured } from '../lib/projects';
import { site } from '../config';
import portraitHero from '../assets/portrait-hero.png';
import imgIdentity from '../assets/projects/leafiesta-logo/cover.jpg';
import imgIllustration from '../assets/projects/rose-lady/cover.jpg';
import imgPrint from '../assets/projects/pizza-flyer/cover.jpg';
import imgSocial from '../assets/projects/this-city-is-ours/cover.jpg';

const featured = await getFeatured(site.featuredCount);
const projectCount = (await getProjectsSorted()).length;

const services = [
  { name: 'Logo & Brand Identity', img: imgIdentity, alt: 'Leafiesta logo design' },
  { name: 'Character & Illustration', img: imgIllustration, alt: 'Rose Lady illustration' },
  { name: 'Print & Flyer Design', img: imgPrint, alt: 'Pizza Friday flyer' },
  { name: 'Poster & Social Graphics', img: imgSocial, alt: 'This City Is Ours poster art' },
];
---

<BaseLayout title={site.name} description={site.intro} ogImage={imgIllustration.src}>
  <section class="hero">
    <div class="glow hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div>
        <p class="hero__eyebrow">
          {site.availability}
        </p>
        <h1>
          Design with personality, <span>precision</span> and
          {site.yearsExperience} years of practice.
        </h1>
        <p class="hero__lead">
          Brand identity, illustration and print by {site.name},
          {site.fiverr.level}.
        </p>
        <a class="hero__cta" href="/contact/">Get in touch</a>
      </div>
      <div class="hero__portrait">
        <Image
          src={portraitHero}
          alt={`Portrait of ${site.name}, graphic designer`}
          width={900}
          priority
        />
      </div>
    </div>
  </section>

  <section class="container" data-reveal>
    <div class="stats">
      <div class="stats__item">
        <strong>{site.yearsExperience}+</strong><span>Years of experience</span>
      </div>
      <div class="stats__item">
        <strong>{projectCount}</strong><span>Projects in this portfolio</span>
      </div>
      <div class="stats__item">
        <strong>L2</strong><span>Fiverr Level 2 Seller</span>
      </div>
    </div>
  </section>

  <section class="container services" data-reveal>
    <h2 class="section-title">What I do</h2>
    <div class="services__grid">
      {
        services.map((s) => (
          <div class="services__card">
            <img src={s.img.src} alt={s.alt} loading="lazy" width="400" height="300" />
            <h3>{s.name}</h3>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container" data-reveal>
    <div class="work__head">
      <h2 class="section-title">Selected work</h2>
      <a class="work__all" href="/work/">See all work →</a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="container" data-reveal>
    <div class="cta">
      <div class="cta__inner">
        <h2>Have work that needs a designer?</h2>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-4) var(--space-4);
  }

  .hero__glow {
    inset: -25% 25% auto auto;
    width: 36rem;
    height: 32rem;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-3);
    align-items: stretch;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgb(124 107 255 / 0.16);
    border: 1px solid rgb(124 107 255 / 0.4);
    color: #cfc9ff;
    border-radius: 999px;
    padding: 0.35rem 1rem;
    font-size: 0.9rem;
    margin: 0 0 1.4rem;
  }

  .hero__eyebrow::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    margin: 0 0 1.2rem;
  }

  h1 span {
    color: #8f7dff;
  }

  .hero__lead {
    color: var(--muted);
    font-size: 1.15rem;
    max-width: 30rem;
    margin: 0 0 1.8rem;
  }

  .hero__cta {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    padding: 0.85rem 1.8rem;
    border-radius: 999px;
    transition: transform 0.2s ease;
  }

  .hero__cta:hover {
    transform: translateY(-2px);
  }

  .hero__cta:active {
    transform: scale(0.98);
  }

  .hero__portrait {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    align-items: end;
    justify-content: center;
  }

  .hero__portrait img {
    width: 100%;
    display: block;
    margin-bottom: -2px;
  }

  @media (max-width: 56rem) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__portrait {
      max-width: 22rem;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    margin-block: var(--space-2) var(--space-4);
  }

  .stats__item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.6rem;
  }

  .stats__item strong {
    font-size: 2.2rem;
    font-weight: 600;
    display: block;
    color: #8f7dff;
  }

  .stats__item span {
    color: var(--muted);
  }

  @media (max-width: 48rem) {
    .stats {
      grid-template-columns: 1fr;
    }
  }

  .section-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin: 0 0 var(--space-3);
  }

  .services {
    padding-block: var(--space-2) var(--space-4);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-2);
  }

  .services__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .services__card:hover {
    transform: translateY(-4px);
    border-color: rgb(124 107 255 / 0.6);
  }

  .services__card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .services__card h3 {
    font-size: 1.1rem;
    margin: 0;
    padding: 1rem 1.2rem;
  }

  .work__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .work__all {
    color: var(--muted);
    font-weight: 600;
  }

  .work__all:hover {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .cta {
    background: linear-gradient(135deg, #7c6bff, #b96bff 55%, #ff7ad8);
    color: var(--accent-ink);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
  }

  .cta__inner {
    padding: var(--space-4) var(--space-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    align-items: center;
  }

  .cta h2 {
    font-size: clamp(1.8rem, 4.5vw, 3.2rem);
    margin: 0;
    color: var(--accent-ink);
  }

  .cta a {
    font-weight: 600;
    color: var(--accent-ink);
    font-size: 1.1rem;
  }
</style>
