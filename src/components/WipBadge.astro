---
const { label = 'In progress' } = Astro.props;
---

<span class="wip-badge">{label}</span>

<style>
  .wip-badge {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
</style>
