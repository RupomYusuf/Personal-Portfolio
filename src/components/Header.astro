---
import { site } from '../config';
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <span class="site-header__dot" aria-hidden="true"></span>
      {site.name}
    </a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[{ on: current.startsWith(l.href) }]}
            aria-current={current.startsWith(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a class="site-header__book" href="/contact/">Book Free Call</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(244 244 246 / 0.75);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.9rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .site-header__dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--ink);
    display: inline-grid;
    place-items: center;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.95rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  nav a:hover {
    color: var(--ink);
    background: rgb(16 16 26 / 0.06);
  }

  nav a.on {
    color: var(--ink);
    font-weight: 600;
  }

  .site-header__book {
    background: var(--ink);
    color: #fff;
    font-weight: 600;
  }

  .site-header__book:hover {
    background: #2a2a32;
    color: #fff;
  }
</style>
